NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/four_year_planner
DATABASE_POOL_MAX=5
OPENAI_API_KEY=
OPENAI_TRANSCRIPT_MODEL=gpt-5.5-nano
OPENAI_TRANSCRIPT_TIMEOUT_MS=20000

# Apply docs/migrations/2026-09-08-abuse-limits.sql before deploying.
# Required in production: generate a random secret of at least 32 characters.
ABUSE_IP_HASH_SECRET=
# Vercel uses its protected IP header automatically. For another host, set only
# a header your trusted ingress overwrites, and block direct access to the app.
# If unset outside Vercel, requests share a conservative unknown-IP bucket.
ABUSE_TRUSTED_IP_HEADER=
TRANSCRIPT_PARSING_ENABLED=true
TRANSCRIPTS_PER_USER_DAY=5
TRANSCRIPTS_PER_IP_HOUR=30
TRANSCRIPTS_PER_DAY=200
TRANSCRIPT_MAX_CONCURRENT=4
GUEST_CREATIONS_PER_IP_HOUR=30
GUEST_CREATIONS_PER_DAY=1000
COURSE_REQUESTS_PER_IP_MINUTE=120
